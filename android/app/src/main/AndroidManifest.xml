<?xml version="1.0" encoding="utf-8"?>
<!--
  An instrument's manifest declares only what is its own: the label, the theme,
  and its Activity. Everything else merges in — posture from core, permissions
  and providers from the plugin modules it depends on. Requesting a permission
  HERE would be the smell: it belongs in a plugin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- golem takes one position fix, on a tap ("declination here"); it never logs in the background. The gnss plugin's
         logger and what it needs are removed: no foreground service, no notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />

    <application
        android:label="golem"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".InstrumentActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with golem" and the share sheet (the intake plugin): the files golem reads, and text -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.apache.parquet" />
                <data android:mimeType="image/vnd.dxf" />
            </intent-filter>
        </activity>
        <service android:name="org.gentropic.leadacid.gnss.GnssLogService" tools:node="remove" />
    </application>
</manifest>
